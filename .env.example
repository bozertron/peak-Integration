# ---------------------------------------------------------------------------
# Peak Integration — environment template
# Copy to `.env.local` (gitignored) and fill in real values.
# ---------------------------------------------------------------------------

# Postgres connection string used by `lib/db/index.ts` (node-postgres Pool)
# and by Better Auth, which is handed that same pool in `lib/auth.ts`.
DATABASE_URL=postgres://peak:peak@127.0.0.1:5432/peak

# Required by Better Auth to sign sessions. Without it the server throws
# "You are using the default secret" on every request that touches auth.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public origin of the app. Better Auth uses it for callbacks, redirects and
# trusted origins. Locally this is the dev server; on Vercel the VERCEL_URL /
# VERCEL_PROJECT_PRODUCTION_URL fallbacks in `lib/auth.ts` cover it instead.
BETTER_AUTH_URL=http://localhost:3000
